/*
 * Apple MacBook Neo
 *
 * target-type: J700
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8140.dtsi"
/ {
	compatible = "apple,j700", "apple,t8140", "apple,arm-platform";
	model = "Apple MacBook Neo";

	aliases {
		atcphy0 = &atcphy0;
		serial0 = &serial0;
		keyboard = &keyboard;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "serial0";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* To be filled by loader */
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x100 0 0x2 0>; /* To be filled by loader */
	};
};

/*
 * Phase-1 wireless inventory only.  The exact register windows, IRQs, port
 * count, MSI range and PERST GPIO come from the live J700 ADT captured as
 * neo-bringup/build/j700-live-adt.bin (SHA-256 f117dd865b13ce90336e5a070b333ea45b1620320be576260c0e36d5f24a2e3c).
 * m1n1 has already initialized port 0 and left its link up before Linux.
 * Describe only the generic host bridge here: no bogus Broadcom compatible,
 * no endpoint node, and no IOMMU RID/SID map until PCI enumeration proves the
 * two real functions and Phase 2 authorizes DMA.
 */
&soc {
	pcie0_dart: iommu@390000000 {
		compatible = "apple,t8140-dart", "apple,t8110-dart";
		reg = <0x3 0x90000000 0x0 0x20000>;
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1206 IRQ_TYPE_LEVEL_HIGH>;
	};

	pcie0: pcie@1cb0000000 {
		compatible = "apple,t8140-pcie", "apple,t6020-pcie";
		device_type = "pci";

		reg = <0x1c 0xb0000000 0x0 0x10000000>, /* ECAM */
		      <0x3 0x94000000 0x0 0x4000>,     /* RC */
		      <0x3 0x90028000 0x0 0x8000>,     /* port 0 */
		      <0x3 0x97020000 0x0 0x4000>;     /* port 0 PHY */
		reg-names = "config", "rc", "port0", "phy0";

		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1205 IRQ_TYPE_LEVEL_HIGH>;

		msi-controller;
		msi-parent = <&pcie0>;
		msi-ranges = <&aic AIC_IRQ 1331 IRQ_TYPE_EDGE_RISING 32>;

		bus-range = <0 8>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x43000000 0xb 0xc0000000 0xb 0xc0000000 0x0 0x20000000>,
			 <0x02000000 0x0 0x80000000 0xb 0x80000000 0x0 0x40000000>;

		port00: pci@0,0 {
			device_type = "pci";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			reset-gpios = <&pinctrl_ap 114 GPIO_ACTIVE_LOW>;
			/*
			 * Live J700 ADT function-reg_on is
			 * pKW8("pcIO", 0x800000, 0x80000).  Aurora IRC
			 * 92012-92014 records the hardware pass through the existing
			 * macsmc-gpio provider as pin 8.
			 */
			pwren-gpios = <&smc_gpio 8 GPIO_ACTIVE_HIGH>;
			maximum-link-speed = <2>;

			#address-cells = <3>;
			#size-cells = <2>;
			ranges;

			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
					<0 0 0 2 &port00 0 0 0 1>,
					<0 0 0 3 &port00 0 0 0 2>,
					<0 0 0 4 &port00 0 0 0 3>;
		};
	};
};

&serial0 {
	status = "okay";
};

&pinctrl_ap {
	status = "okay";
};

/*
 * Keep the fixed VL122 out of reset for the complete Linux lifetime.  Its I2C
 * plane NACKs while the USB core is running, so only configure and open the
 * independent TICD2E22 eUSB repeater at address 0x21.
 */
&i2c2 {
	apple,j700-usb-apply-repeater-tunable;
	apple,j700-usb-read-only-diagnostics;
	hub-reset-gpios = <&pinctrl_ap 142 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&dwc3_0 {
	/delete-property/ hub-reset-gpios;
	apple,usb2-hub-always-on;
	status = "okay";

	/*
	 * One fixed VL122 hub fans this DWC3 USB2 link out to both HPMs.  Keep
	 * separate role-switch inputs so either connector can report cable state
	 * without tearing down or stealing the shared always-on host.
	 */
	usb2-role-inputs {
		#address-cells = <1>;
		#size-cells = <0>;

		usb2-role-input@0 {
			reg = <0>;
			usb-role-switch;

			port {
				dwc3_0_hs_rear: endpoint {
					remote-endpoint = <&typec0_connector_hs>;
				};
			};
		};

		usb2-role-input@1 {
			reg = <1>;
			usb-role-switch;

			port {
				dwc3_0_hs_front: endpoint {
					remote-endpoint = <&typec1_connector_hs>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dwc3_0_ss: endpoint {
				remote-endpoint = <&atcphy0_usb3>;
			};
		};
	};
};

/*
 * J700 has one DWC3 and two HPMs.  Both connectors' USB2 signals reach DWC3
 * through the permanently connected VL122 hub, so neither HPM is a USB2 role
 * source: disconnecting either downstream cable must leave the host and hub
 * running.  The rear/DFU-side HPM owns the only direct ATC/SuperSpeed lane;
 * the front connector has no direct ATC endpoint.
 */
&nub_spmi_a0 {
	status = "okay";

	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <13 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-rear";
			power-role = "dual";
			data-role = "host";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs_rear>;
					};
				};

				port@1 {
					reg = <1>;

					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <39 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-front";
			power-role = "dual";
			data-role = "host";

			port {
				typec1_connector_hs: endpoint {
					remote-endpoint = <&dwc3_0_hs_front>;
				};
			};
		};
	};
};

&atcphy0 {
	/*
	 * Live J700 ADT tunable_USB2PHY_REG_DFLT.  XNU applies this to ATC
	 * memory region 2 at the end of AppleT8130TypeCPhy::eusb2phy_init().
	 */
	apple,tunable-usb2phy-reg-dflt =
		<0x80 0x000000ff 0x00000017>,
		<0x84 0x000003ff 0x000000c8>,
		<0x88 0x000000ff 0x00000005>,
		<0x8c 0x000003ff 0x00000005>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			atcphy0_typec_lanes: endpoint {
				remote-endpoint = <&typec0_connector_ss>;
			};
		};

		port@1 {
			reg = <1>;

			atcphy0_usb3: endpoint {
				remote-endpoint = <&dwc3_0_ss>;
			};
		};
	};
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

/*
 * iBoot leaves both SMC I2C domains active.  Powering either one down on
 * J700 causes a delayed SError, so Linux must preserve the inherited state.
 */
&ps_smc_i2cm1 {
	apple,always-on;
};

&ps_smc_i2cm2 {
	apple,always-on;
};

/*
 * Keep U-Boot from owning this transport on T8140.  Its driver explicitly
 * declines the device before touching RTKit; Linux must initialize MTP first.
 */
&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	apple,no-stm;

	multi-touch {
		firmware-name = "apple/tpmtfw-j700.bin";
		apple,adopt-preinitialized-ipd-functions;
		apple,ack-preinitialized-afe-pulse;
	};

	keyboard: keyboard {
		hid-country-code = <33>;
		apple,keyboard-layout-id = <5>;
	};
};
